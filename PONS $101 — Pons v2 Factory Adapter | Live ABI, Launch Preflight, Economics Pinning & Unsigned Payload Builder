export async function
checkPairToken(
  pairToken:
    `0x${string}`
) {
  if (
    pairToken.toLowerCase()
    ===
    NATIVE_PAIR.toLowerCase()
  ) {
    return {
      approved:
        true,
      native:
        true,
      economics:
        null
    };
  }
  const [
    approved,
    economics
  ] =
    await Promise.all([
      robinhoodClient.readContract({
        address:
          PONS_V2_FACTORY,
        abi:
          ponsV2FactoryAbi,
        functionName:
          "approvedPairTokens",
        args:
          [pairToken]
      }),
      robinhoodClient.readContract({
        address:
          PONS_V2_FACTORY,
        abi:
          ponsV2FactoryAbi,
        functionName:
          "pairTokenEconomics",
        args:
          [pairToken]
      })
    ]);
  const [
    phantomQuote,
    graduationThreshold,
    decimals
  ] =
    economics;
  const economicallyConfigured =
    phantomQuote > 0n
    &&
    graduationThreshold > 0n;
  return {
    approved:
      approved
      &&
      economicallyConfigured,
    native:
      false,
    economics: {
      phantomQuote,
      graduationThreshold,
      decimals
    }
  };
}
