export function validateLaunchManifest(
  manifest: PonsLaunchManifest
) {
  const problems:
    string[] = [];
  if (
    !manifest.experimentId.trim()
  ) {
    problems.push(
      "experimentId is required"
    );
  }
  if (
    !manifest.name.trim()
  ) {
    problems.push(
      "token name is required"
    );
  }
  if (
    !manifest.symbol.trim()
  ) {
    problems.push(
      "token symbol is required"
    );
  }
  if (
    !isAddress(
      manifest.creator
    )
  ) {
    problems.push(
      "creator address invalid"
    );
  }
  if (
    !isAddress(
      manifest.creatorFeeRecipient
    )
  ) {
    problems.push(
      "creatorFeeRecipient invalid"
    );
  }
  if (
    !isAddress(
      manifest.pairToken
    )
  ) {
    problems.push(
      "pairToken invalid"
    );
  }
  if (
    manifest.creatorTaxBps < 0
  ) {
    problems.push(
      "creatorTaxBps cannot be negative"
    );
  }
  if (
    !/^0x[0-9a-fA-F]{64}$/.test(
      manifest.salt
    )
  ) {
    problems.push(
      "salt must be bytes32"
    );
  }
  if (
    (manifest.snipeTaxExemptions?.length ?? 0)
    > 32
  ) {
    problems.push(
      "snipeTaxExemptions exceeds protocol maximum of 32"
    );
  }
  for (
    const exemption
    of manifest.snipeTaxExemptions ?? []
  ) {
    if (
      !isAddress(exemption)
    ) {
      problems.push(
        `invalid snipe exemption: ${exemption}`
      );
    }
  }
  return {
    valid:
      problems.length === 0,
    problems
  };
}
