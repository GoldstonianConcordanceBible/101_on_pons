            Number(count)
        },
        async (_, id) => {
          const config =
            await robinhoodClient.readContract({
              address:
                PONS_V2_FACTORY,
              abi:
                ponsV2FactoryAbi,
              functionName:
                "getLaunchConfig",
              args:
                [BigInt(id)]
            });
          return {
            id:
              BigInt(id),
            supply:
              config.supply,
            curveFeeBps:
              config.curveFeeBps,
            phantomQuote:
              config.phantomQuote,
            graduationThreshold:
